{
  "createOptions": {
    "schema": {
      "title": "Conditional Fields",
      "type": "object",
      "properties": {
        "subscribe": { "type": "boolean", "title": "Subscribe to the newsletter?" }
      },
      "if": { "properties": { "subscribe": { "const": true } } },
      "then": {
        "properties": {
          "email": { "type": "string", "format": "email", "title": "Email address" }
        },
        "required": ["email"]
      }
    }
  }
}
