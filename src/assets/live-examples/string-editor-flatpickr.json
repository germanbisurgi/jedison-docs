{
  "iconLib": "bootstrap-icons",
  "extraHeadCss": [
    "https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
  ],
  "extraHeadJs": [
    "https://cdn.jsdelivr.net/npm/flatpickr"
  ],
  "createOptions": {
    "btnContents": false,
    "enablePropertiesToggle": true,
    "schema": {
      "title": "Flatpickr",
      "type": "string",
      "description": "Flatpickr is a lightweight and powerful datetime picker.",
      "default": "2024-08-27",
      "minLength": 3,
      "x-format": "flatpickr",
      "x-flatpickr": {}
    }
  }
}
